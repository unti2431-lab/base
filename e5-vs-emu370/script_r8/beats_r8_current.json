          "key": "EMU370",
          "reading": "이엠유"
        }
      ]
    },
    {
      "id": "L5",
      "frames": [
        401,
        500
      ],
      "text": "차체 아래의 대차는 무게를 받치고,",
      "reading": "차체 아래의 대차는 무게를 받치고,",
      "nouns": [
